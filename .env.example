# ==============================================================================
# STARWEBFLOW PRO TITAN MODE — API & ORTAM DEĞİŞKENLERİ ŞABLONU (.env.example)
# Gireceğiniz API anahtarlarıyla tüm AI, Görsel, Ses, Reklam ve CRM modülleri aktif olur.
# ==============================================================================

# ─── 1. VERİTABANI (POSTGRESQL) ───────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:3434@localhost:5432/starwebflow_db?schema=public"

# ─── 2. BİRİNCİL AI MOTORU (Google AI Studio Pro) ────────────────────────────
# Almak için: https://aistudio.google.com -> Get API Key
# ÇALIŞTIRDIĞI MODELLER: Gemini 2.5 Flash, Gemini Pro, Imagen 4 (8K Görsel), Veo 3.1 Video
GOOGLE_AI_API_KEY=""

# ─── 3. SEÇENEKLİ / HİBRİT AI APIS (İsteğe Bağlı) ──────────────────────────────
# OpenRouter API (DeepSeek V3, DeepSeek R1, Claude 3.5 Sonnet & Llama 3.3 Tek Tıkla)
# Almak için: https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# OpenAI API (GPT-4o, GPT-4o-mini & Whisper Seslendirme)
# Almak için: https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# Fal.ai API (FLUX.1 Schnell - Salise Hızında 0.001$ Görsel & Hunyuan Video)
# Almak için: https://fal.ai/dashboard/keys
FAL_AI_KEY=""

# Anthropic API (Claude 3.5 Sonnet - İnsan Kalitesinde Derin SEO Makaleleri)
# Almak için: https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# ─── 4. VOICE AGENT & SESLİ ARAMA APIS ───────────────────────────────────────
# ElevenLabs API (Türkçe İnsan Sesi Klonlama & Otomatik DM Sesli Yanıt)
# Almak için: https://elevenlabs.io/
ELEVENLABS_API_KEY=""

# Azure Speech Services (30. Saniyede Telefon Araması & Düşük Gecikmeli Ses)
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION="westeurope"

# ─── 5. MÜŞTERİ AVCISI & REKLAM APIS ─────────────────────────────────────────
# Apify API (Müşteri Avcısı & Harita/Instagram Kazıyıcı)
# Almak için: https://console.apify.com/account/integrations
APIFY_API_TOKEN=""

# Meta Graph API (Instagram Auto-DM Webhook & CAPI)
META_GRAPH_API_KEY=""
META_PIXEL_ID=""

# Google Ads Dev Token (Google Reklam Otomasyonu)
GOOGLE_ADS_DEV_TOKEN=""

# ─── 6. GÜVENLİK & ALTYAPI HİZMETLERİ ─────────────────────────────────────────
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

NEXTAUTH_SECRET="starwebflow-secret-change-in-production"
NEXTAUTH_URL="https://www.starwebflow.com"
NEXT_PUBLIC_APP_URL="https://www.starwebflow.com"

# ─── 7. MAIL HİZMETLERİ (IONOS SMTP - Ücretsiz & Sınırsız) ─────────────────────
MAIL_API_KEY=""
RESEND_FROM_EMAIL="StarWebflow <info@starwebflow.com>"
RESEND_ADMIN_EMAIL="info@starwebflow.com"

SMTP_HOST="smtp.ionos.de"
SMTP_PORT="587"
SMTP_USER="info@starwebflow.com"
SMTP_PASS=""
SMTP_FROM_NAME="StarWebflow"
